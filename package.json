{
  "name": "@realashrafi/offline-video-core",
  "version": "1.0.0",
  "description": "Offline PWA video download manager with OPFS, IndexedDB, Web Locks and AES-GCM encryption",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^5.1.2"
  },
  "keywords": [
    "opfs",
    "indexeddb",
    "pwa",
    "offline-video",
    "web-locks",
    "aes-gcm"
  ],
  "sideEffects": false,
  "license": "MIT"
}
